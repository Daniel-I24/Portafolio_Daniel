# Copy to .env.local (local) and to Vercel → Settings → Environment Variables (production).

# Supabase → Project Settings → API (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose. Not used by the app at runtime today; keep it for maintenance scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Your Supabase Auth user id (the login page shows it on the first sign-in)
ADMIN_USER_ID=

# GitHub fine-grained token (read-only, public repos) for the admin import and sync
GITHUB_TOKEN=

# Contact email: Resend key. Without a verified domain the sender must be onboarding@resend.dev
# and Resend only delivers to the email of your Resend account.
RESEND_API_KEY=
RESEND_FROM=
# Alternative to Resend
FORMSPREE_ID=

# Public site URL for metadata/OG and the OAuth redirect (e.g. https://dani.vercel.app)
NEXT_PUBLIC_SITE_URL=
